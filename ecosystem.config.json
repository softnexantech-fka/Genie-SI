{
  "name": "si-genie-consultant",
  "apps": [
    {
      "name": "si-proxy",
      "script": "api-proxy/api-proxy.js",
      "cwd": "./",
      "interpreter": "node",
      "node_args": "--max-old-space-size=512",
      "env": {
        "NODE_ENV": "production",
        "PROXY_PORT": "3001"
      },
      "env_file": "api-proxy/.env",
      "restart_delay": 5000,
      "max_restarts": 10,
      "min_uptime": "10s",
      "log_date_format": "YYYY-MM-DD HH:mm:ss",
      "error_file": "api-proxy/data/logs/pm2-error.log",
      "out_file": "api-proxy/data/logs/pm2-out.log",
      "merge_logs": true,
      "watch": false,
      "autorestart": true,
      "kill_timeout": 8000,
      "listen_timeout": 10000,
      "shutdown_with_message": true
    }
  ]
}
