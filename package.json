{
  "name": "si-genie-consultant-fixed",
  "private": true,
  "version": "10.5.10",
  "description": "Système d'Information Intégré — Génie Consultant Libreville",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview --host 0.0.0.0",
    "prod": "npm run build && npm run preview",
    "si:start": "powershell -ExecutionPolicy Bypass -File .\\scripts\\si-start.ps1",
    "si:stop": "powershell -ExecutionPolicy Bypass -File .\\scripts\\si-stop.ps1",
    "si:schedule:install": "powershell -ExecutionPolicy Bypass -File .\\scripts\\si-install-schedule.ps1",
    "run:preview": "node scripts/run-preview.js",
    "run:preview:strict": "node scripts/run-preview.js --strict-sqlite --force",
    "lint": "eslint .",
    "test:e2e": "npx playwright test --reporter=list",
    "test:e2e:edge": "npx playwright test --project=msedge --reporter=list",
    "test:e2e:all": "npx playwright test --reporter=html,list",
    "test:e2e:full": "npm run build && concurrently -k \"cd api-proxy && npm start\" \"npm run preview\" \"npx wait-on http://localhost:5173 http://localhost:3001 && npm run test:e2e:all\" && npm run test:report",
    "test:e2e:auth": "npx playwright test si-e2e-auth.spec.ts --reporter=list",
    "test:e2e:docs": "npx playwright test si-e2e-documents.spec.ts --reporter=list",
    "test:e2e:finance": "npx playwright test si-e2e-finance.spec.ts --reporter=list",
    "test:e2e:messaging": "npx playwright test si-e2e-messaging.spec.ts --reporter=list",
    "test:e2e:admin": "npx playwright test si-e2e-admin.spec.ts --reporter=list",
    "test:e2e:approvals": "npx playwright test si-e2e-approvals.spec.ts --reporter=list",
    "test:e2e:errors": "npx playwright test si-e2e-errors-security.spec.ts --reporter=list",
    "test:e2e:workflows": "npx playwright test si-e2e-workflows-complete.spec.ts --reporter=list",
    "test:e2e:dynamic": "node tests/run-dynamic.js",
    "test:report": "node tests/generate-report.js"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.15.0",
    "vite": "^6.4.2",
    "vite-plugin-compression": "^0.5.1",
    "wait-on": "^8.0.1"
  },
  "_note_deps_removed_v128": "Dépendances backend retirées des deps frontend : bcryptjs, cors, express-validator, helmet, jsonwebtoken — elles appartiennent uniquement à api-proxy/package.json"
}
