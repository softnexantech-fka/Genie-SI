  "browsers": {
    "primary": "msedge",
    "secondary": ["chromium", "firefox"]
  },
  "users": {
    "dg": {
      "role": "DG",
      "permissions": ["all"]
    },
    "admin": {
      "role": "Admin",
      "permissions": ["manage_users", "view_reports"]
    },
    "collaborateur": {
      "role": "Collaborateur",
      "permissions": ["create_docs", "view_own"]
    },
    "client": {
      "role": "Client",
      "permissions": ["view_assigned", "sign_docs"]
    },
    "audit": {
      "role": "Audit",
      "permissions": ["view_all", "audit_logs"]
    }
  },
  "features": {
    "encryption": true,
    "jwt_sessions": true,
    "role_based_access": true,
    "document_sharing": true,
    "approval_cascades": true,
    "messaging": true,
    "finance_operations": true
  },
  "settings": {
    "timeout": 30000,
    "retries": 2,
    "headless": true,
    "parallel": false
  }
